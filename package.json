{
  "name": "anstool-desktop",
  "version": "2.0.0",
  "description": "ANSTOOL - 1-Click Steam Game Unlocker & Manager",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.anstool.desktop",
    "productName": "ANSTOOL",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "electron",
    "desktop",
    "steam",
    "anstool"
  ],
  "author": "MuhammadAsad809",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1"
  }
}
